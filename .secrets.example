# Reference for the GitHub Actions secrets this repo expects.
# Copy to .secrets (gitignored) or paste the values into
# Settings -> Secrets and variables -> Actions.

# --- OCI API signing key (Console -> My profile -> API keys -> Add API key) ---
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaexample
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaexample
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----

# --- Object Storage namespace (oci os ns get) ---
OCI_NAMESPACE=axxxxxxxxxxx

# --- Customer Secret Key, for the S3-compatible remote state backend ---
# (Console -> My profile -> Customer secret keys). NOT the API signing key.
OCI_S3_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Remote state location ---
TF_BUCKET_NAME=[username]-terraform-state-bucket
TF_BUCKET_PREFIX=terraform-oraclecloud-objectstorage
